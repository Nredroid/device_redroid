
prebuilt_etc {
    name: "amdgpu.ids.redroid",
    relative_install_path: "hwdata",
    proprietary: true,
    src: "share/libdrm/amdgpu.ids",
}


cc_prebuilt_library_shared {
    name: "audio.primary.redroid",

    arch: {
        x86_64: {
            srcs: ["x86_64/audio.primary.redroid.so"],
        },
        x86: {
            srcs: ["x86/audio.primary.redroid.so"],
        },
        arm: {
            srcs: ["arm/audio.primary.redroid.so"],
        },
        arm64: {
            srcs: ["aarch64/audio.primary.redroid.so"],
        },
    },


    relative_install_path: "hw",
    compile_multilib: "both",
    proprietary: true,
    check_elf_files: false,
}

